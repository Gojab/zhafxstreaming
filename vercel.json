{
  "rewrites": [
    {
      "source": "/api/anime/:action*",
      "destination": "/api/anime/[action]"
    },
    {
      "source": "/auth/google/callback",
      "destination": "/api/auth/[action]?action=google-callback"
    },
    {
      "source": "/auth/callback",
      "destination": "/api/auth/[action]?action=google-callback"
    },
    {
      "source": "/auth/google/login",
      "destination": "/api/auth/[action]?action=google-login-url"
    },
    {
      "source": "/api/auth/:action*",
      "destination": "/api/auth/[action]"
    },
    {
      "source": "/api/trending",
      "destination": "/api/discover?trending=true"
    },
    {
      "source": "/api/season",
      "destination": "/api/stream?action=season"
    },
    {
      "source": "/api/providers",
      "destination": "/api/stream?action=providers"
    },
    {
      "source": "/api/ai/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|llms\\.txt|ai-catalog\\.json|\\.well-known/|assets/|google[a-zA-Z0-9_-]+\\.html|favicon|apple-touch-icon|icon-|logo\\.png|site\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/.well-known/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}

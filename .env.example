# ========================================================
# ZHAFX STREAMING PLATFORM - ENVIRONMENT VARIABLES
# Masukkan variabel di bawah ini ke Vercel:
# Dashboard Vercel -> Project Anda -> Settings -> Environment Variables
# ========================================================

# 1. Google Gemini AI API Key (Wajib untuk fitur Tanya Zhafx AI)
# Dapatkan API key gratis di: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Google OAuth Client ID (Untuk Login dengan Akun Google)
VITE_GOOGLE_CLIENT_ID=358715674309-hdh36g2l56bqv0rckcvcd4666kemh4sj.apps.googleusercontent.com

# 3. Google OAuth Client Secret (Rahasia Server-Side untuk verifikasi OAuth)
GOOGLE_CLIENT_SECRET=

# 4. Server Port (Opsional, bawaan 3000)
PORT=3000
